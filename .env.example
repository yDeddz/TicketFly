# Produção André/yDeddz: https://www.ticketfly.app
# UI local: http://localhost:3000
# Não usar ticket-fly.vercel.app em APP_URL (atalho técnico da Vercel)
NEXT_PUBLIC_APP_URL=https://www.ticketfly.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret

# Mercado Pago Marketplace Connect (OAuth por organizador)
# MERCADO_PAGO_CLIENT_ID=
# MERCADO_PAGO_CLIENT_SECRET=
# Redirect URI na app MP: {NEXT_PUBLIC_APP_URL}/api/organizer/mp/callback

# Asaas (subcontas + split para organizadores)
# ASAAS_API_KEY=
# ASAAS_API_URL=https://api-sandbox.asaas.com
# Produção: https://api.asaas.com
# ASAAS_WEBHOOK_TOKEN=  # access_token header enviado pelo Asaas no webhook
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/asaas
# Depois do .env.local: npm run ops:check
# Seed do evento de teste: supabase/seed_test_ops.sql

# QR / check-in / ticket access signing (min 32 chars). Falls back to SERVICE_ROLE_KEY if unset.
TICKET_QR_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Cron externo (Vercel Hobby não agenda a cada 10 min).
# O job chama GET/POST {NEXT_PUBLIC_APP_URL}/api/cron/expire-reservations
# Header: Authorization: Bearer <este valor>  OU  x-cron-secret: <este valor>
# Tem que ser o MESMO secret na Vercel Production e no site de cron.
CRON_SECRET=replace-with-a-different-long-random-secret

# Optional — Google Wallet (Save to Wallet)
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_EMAIL=
# GOOGLE_WALLET_SERVICE_PRIVATE_KEY=

# Optional — Apple Wallet (.pkpass) — requires Apple Developer Pass Type ID + OpenSSL
# APPLE_PASS_TYPE_ID=pass.br.com.pinkpass.ticket
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_WWDR_CERT_PEM=
